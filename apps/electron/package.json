{
  "name": "@get-halo/desktop",
  "version": "0.1.54",
  "private": true,
  "description": "Halo desktop app",
  "license": "Apache-2.0",
  "author": "Saffron Health, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/cashew-labs/halo.git"
  },
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "build": "electron-forge package",
    "dev": "electron-forge start",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "format": "oxfmt src forge e2e index.html package.json tsconfig.json forge.config.ts playwright.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "format:check": "oxfmt --check src forge e2e index.html package.json tsconfig.json forge.config.ts playwright.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src forge e2e forge.config.ts playwright.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src forge e2e forge.config.ts playwright.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts",
    "test": "pnpm run test:e2e",
    "test:e2e:build": "pnpm --filter @get-halo/web-app build && electron-forge package",
    "test:e2e:run": "playwright test",
    "test:e2e": "pnpm run test:e2e:build && playwright test",
    "typecheck": "pnpm --filter @get-halo/extension-tools build && tsc --noEmit && tsc --noEmit -p src/main/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@get-halo/cli": "workspace:*",
    "@get-halo/client": "workspace:*",
    "@get-halo/config": "workspace:*",
    "@get-halo/logger": "workspace:*",
    "@get-halo/shared": "workspace:*",
    "@get-halo/web": "workspace:*",
    "@get-halo/workspace-server": "workspace:*",
    "@orpc/client": "2.0.0-beta.29",
    "@parcel/watcher": "^2.6.0",
    "@sinclair/typebox": "^0.34.52",
    "electron-squirrel-startup": "^1.0.1",
    "errore": "^0.14.1",
    "google-auth-library": "^11.0.2",
    "maui": "npm:@tanishqkancharla/maui@0.0.33",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@get-halo/app-control": "workspace:*",
    "@get-halo/extension-tools": "workspace:*",
    "@get-halo/typescript-config": "workspace:*",
    "@orpc/server": "2.0.0-beta.29",
    "@playwright/test": "1.62.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "agentation-mcp": "^1.2.0",
    "better-auth": "1.7.4",
    "electron": "^44.0.0",
    "execa": "9.6.1",
    "libretto-browser-tools": "^0.1.2",
    "playwright": "1.62.1",
    "vite": "^8.2.2"
  },
  "productName": "Halo"
}
