{
  "name": "@get-halo/workspace-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/HaloServer.ts",
    "./agent": "./src/agent.ts",
    "./cli": "./src/cli.ts",
    "./filesystem": "./src/filesystem.ts",
    "./llm": "./src/llm.ts",
    "./testing": "./src/testing.ts",
    "./router": "./src/router.ts",
    "./sessions": "./src/sessions.ts",
    "./workspace": "./src/workspace.ts",
    "./process": "./src/WorkspaceServerProcess.ts",
    "./connection": "./src/ConnectionFile.ts"
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src test",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src test",
    "test": "vitest run --reporter=agent",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@executor-js/codemode-core": "1.6.0",
    "@executor-js/execution": "1.6.0",
    "@executor-js/fumadb": "1.5.7",
    "@executor-js/plugin-openapi": "1.6.0",
    "@executor-js/runtime-quickjs": "1.6.0",
    "@executor-js/sdk": "1.6.0",
    "@get-halo/config": "workspace:*",
    "@get-halo/shared": "workspace:*",
    "@halo/cli": "workspace:*",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.31.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/server": "2.0.0-beta.29",
    "@orpc/shared": "2.0.0-beta.29",
    "@parcel/watcher": "^2.6.0",
    "@repo/logger": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@tursodatabase/database": "0.7.2",
    "drizzle-orm": "0.45.0",
    "effect": "4.0.0-beta.59",
    "errore": "^0.14.1",
    "google-auth-library": "^11.0.2",
    "libretto-browser-tools": "^0.1.2",
    "maui": "npm:@tanishqkancharla/maui@0.0.19",
    "playwright": "1.62.1",
    "quickjs-emscripten": "0.31.0",
    "tsx": "^4.23.13",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@orpc/client": "2.0.0-beta.29",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "openai": "6.26.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
