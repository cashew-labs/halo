{
  "name": "@get-halo/workspace-server-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src desktop",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src desktop",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --include '../../packages/workspace-server/dist/**/*.js' src/main.ts",
    "start": "pnpm --filter @get-halo/workspace-server build && tsx src/main.ts"
  },
  "dependencies": {
    "@get-halo/config": "workspace:*",
    "@get-halo/logger": "workspace:*",
    "@get-halo/shared": "workspace:*",
    "@get-halo/workspace-server": "workspace:*",
    "@orpc/client": "2.0.0-beta.29",
    "errore": "^0.14.1",
    "google-auth-library": "^11.0.2",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@get-halo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "7.0.2"
  }
}
