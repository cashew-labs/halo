{
  "environment": "cloud",
  "workspaceRoot": "/home/node",
  "appDataDir": "/home/node/.halo/runtime",
  "appVersion": "0.0.0",
  "ownerUserId": "development",
  "logFilePath": "/home/node/.halo/runtime/logs/server.jsonl",
  "corsOrigins": ["null"],
  "port": 8788,
  "cliEntry": "/opt/halo/packages/halo-cli/src/cli.ts",
  "cliNodeExecutable": "/usr/local/bin/node",
  "extensionRuntime": {
    "executable": "/usr/local/bin/node",
    "electronRunAsNode": false
  },
  "googleWebOAuth": {
    "kind": "secretManager",
    "projectId": "halo-relay",
    "clientIdSecretId": "halo-west-workspace-google-web-client-id",
    "clientSecretSecretId": "halo-west-workspace-google-web-client-secret"
  }
}
