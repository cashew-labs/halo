+        // The lease may span many idle periods. Its release starts a fresh
+        // full idle window, rather than expiring at the next poll.
+        let idle = now + UNRESTRICTED_IDLE_TTL * 3;
+        pool.inner.reap_idle(idle).await;
+        pool.inner
+            .reap_idle(idle + UNRESTRICTED_IDLE_TTL - Duration::from_millis(1))
+            .await;
+        let reused = pool.get(&url).await.unwrap();
+        assert!(weak.ptr_eq(&Arc::downgrade(&reused)));
+        drop(reused);
