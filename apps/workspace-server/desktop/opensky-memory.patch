+        let weak = Arc::downgrade(&first);
+        let now = Instant::now();
+        pool.inner.reap_idle(now).await;
+        pool.inner.reap_idle(now + UNRESTRICTED_IDLE_TTL * 2).await;
+        first.call(None, "Still.leased", json!({})).await.unwrap();
+        drop(first);
