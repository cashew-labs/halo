+    #[tokio::test]
+    async fn shared_idle_pages_detach_without_replacing_the_consented_socket() {
+        let detach_calls = Arc::new(StdMutex::new(Vec::new()));
+        let log = detach_calls.clone();
+        let next = AtomicU64::new(0);
+        let server = MockCdpServer::start(Arc::new(move |call| match call.method.as_str() {
+            "Target.attachToTarget" => MockReply::ok(
+                json!({"sessionId": format!("s{}", next.fetch_add(1, Ordering::Relaxed))}),
+            ),
+            "Target.detachFromTarget" => {
+                let mut calls = log.lock().unwrap();
+                calls.push(call.params["sessionId"].as_str().unwrap().to_owned());
+                if calls.len() == 1 {
+                    MockReply::err(-32000, "detach temporarily unavailable")
+                } else {
+                    MockReply::ok(json!({}))
+                }
+            }
+            _ => MockReply::ok(json!({})),
+        }))
+        .await;
+        let pool = CdpPool::new();
+        let url = server.ws_url();
+        // This is the cloud route: claim/get_existing, never unrestricted get.
+        let conn = pool.claim_existing(&url, 1).await.unwrap();
+        let weak = Arc::downgrade(&conn);
+        for index in 0..IDLE_DETACH_BATCH + 1 {
+            let result = conn
+                .call(
+                    None,
+                    "Target.attachToTarget",
+                    json!({"targetId": format!("page-{index}"), "flatten": true}),
+                )
+                .await
+                .unwrap();
+            if index == 0 {
+                conn.register_dialog_session(result["sessionId"].as_str().unwrap(), "page-0");
+            }
+        }
+        let now = Instant::now();
+        pool.inner.reap_idle(now).await;
+        pool.inner.reap_idle(now + UNRESTRICTED_IDLE_TTL * 2).await;
+        assert!(
+            detach_calls.lock().unwrap().is_empty(),
+            "live Arc lease protects all page sessions"
+        );
+        drop(conn);
+        let idle = now + UNRESTRICTED_IDLE_TTL * 3;
+        pool.inner.reap_idle(idle).await;
+        // get_existing resets the full idle period, even between polls.
+        drop(pool.get_existing(&url, 1).await.unwrap());
+        pool.inner.reap_idle(idle + UNRESTRICTED_IDLE_TTL).await;
+        assert!(detach_calls.lock().unwrap().is_empty());
