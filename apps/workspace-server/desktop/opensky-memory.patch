+                let attached = entry.conn.demux.attached_targets.lock().unwrap();
+                let dialogs = entry.conn.demux.dialogs.lock().unwrap();
+                attached
+                    .iter()
+                    .filter(|(_, target)| !dialogs.contains_key(*target))
+                    .take(remaining)
+                    .map(|(sid, _)| sid.clone())
+                    .collect()
+            };
+            for sid in sessions {
+                let wait = deadline.saturating_duration_since(tokio::time::Instant::now());
+                if wait.is_zero() {
