+        let idle = idle + UNRESTRICTED_IDLE_TTL;
+        pool.inner.reap_idle(idle).await;
+        pool.inner
+            .reap_idle(idle + UNRESTRICTED_IDLE_TTL - Duration::from_millis(1))
+            .await;
+        assert!(weak.upgrade().is_some());
+        pool.inner.reap_idle(idle + UNRESTRICTED_IDLE_TTL).await;
+        assert!(weak.upgrade().is_none());
+        let redialed = pool.get(&url).await.unwrap();
+        assert!(!weak.ptr_eq(&Arc::downgrade(&redialed)));
+        redialed
+            .call(None, "After.redial", json!({}))
+            .await
+            .unwrap();
+    }
