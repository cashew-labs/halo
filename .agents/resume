#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:${PNPM_HOME:-$HOME/.local/share/pnpm}/bin:$PATH"

if [[ -n "${HALO_GCP_SA_KEY:-}" ]]; then
  mkdir -p "$HOME/.config/gcloud"
  node --input-type=module <<'EOF'
import fs from "node:fs";

const raw = process.env.HALO_GCP_SA_KEY;
if (raw === undefined) process.exit(0);
let credential;
try {
  credential = JSON.parse(raw);
} catch {
  credential = JSON.parse(Buffer.from(raw, "base64").toString("utf8"));
}
if (credential?.type !== "service_account") {
  throw new Error("HALO_GCP_SA_KEY is not a service-account credential");
}
fs.writeFileSync(
  `${process.env.HOME}/.config/gcloud/application_default_credentials.json`,
  JSON.stringify(credential),
  { mode: 0o600 },
);
EOF
fi

# Retire state left by older warm orbs without deleting checkpoints or memories.
if command -v amp >/dev/null; then
  services="$(amp orb service list)"
  if grep -q '^amp-svc-entire-memory\.service ' <<< "$services"; then
    amp orb service stop entire-memory
  fi
fi
if [[ -f .entire/settings.local.json ]]; then
  node --input-type=module <<'EOF'
import fs from "node:fs";

const file = ".entire/settings.local.json";
const settings = JSON.parse(fs.readFileSync(file, "utf8"));
if (settings.enabled !== false) {
  settings.enabled = false;
  fs.writeFileSync(file, `${JSON.stringify(settings, null, 2)}\n`);
}
EOF
fi

echo "Orb ready"
