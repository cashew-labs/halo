+
+test("Code inspection resolves aliases, constructor inputs, method outputs and record fields", async () => {
+  const declarations = `/** Tracks an accumulated total. */
+export class Counter {
+  constructor(ctx: { start: number }) { this.total = ctx.start; }
+  total: number;
+  /** Adds a value to the total. */
+  add(value: number): number { return this.total += value; }
+}
+export type Item = { name: string; count: number };
+`;
+  fs.writeFileSync(path.join(root, "counter.ts"), declarations);
+  const calls =
+    'import { Counter as Renamed, type Item } from "./counter.js";\nconst counter = new Renamed({ start: 1 });\ncounter.add(2);\nconst item: Item = { name: "x", count: 1 };\n';
+  fs.writeFileSync(path.join(root, "calls.ts"), calls);
+  const type = await findDefinition(
+    root,
+    params("calls.ts", 2, "Renamed", calls),
+  );
+  assert.ok(type && !(type instanceof Error));
+  assert.equal(type.symbol?.name, "Counter");
+  assert.match(type.symbol!.documentation, /accumulated total/);
+  assert.equal(type.symbol?.parameters[0]?.name, "ctx");
+  assert.match(type.symbol!.parameters[0]!.type, /start: number/);
+  assert.equal(type.symbol?.returnType, "Counter");
+  const method = await findDefinition(
+    root,
+    params("calls.ts", 3, "add", calls),
+  );
+  assert.ok(method && !(method instanceof Error));
+  assert.equal(method.symbol?.name, "Counter.add");
+  assert.deepEqual(method.symbol?.parameters, [
+    { name: "value", type: "number" },
+  ]);
+  assert.equal(method.symbol?.returnType, "number");
+  const record = await findDefinition(
+    root,
+    params("calls.ts", 4, "Item", calls),
+  );
+  assert.ok(record && !(record instanceof Error));
+  assert.deepEqual(
+    record.symbol?.members.map(({ name, type }) => ({ name, type })),
+    [
+      { name: "name", type: "string" },
+      { name: "count", type: "number" },
+    ],
+  );
+});
