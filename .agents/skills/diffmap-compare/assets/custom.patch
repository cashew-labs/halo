new file mode 100644
index 0000000..2a9d1a2
--- /dev/null
+++ b/src/viewer/ReviewTabs.tsx
@@ -0,0 +1,86 @@
+import { useLayoutEffect, useRef } from "react";
+
+export function ReviewTabs(props: {
+  tabs: { id: number; label: string }[];
+  activeId: number;
+  onActivate: (id: number) => void;
+  onClose: (id: number) => void;
+}) {
+  const tabStrip = useRef<HTMLDivElement>(null);
+  const restoreTabFocus = useRef(false);
+  useLayoutEffect(() => {
+    const active = tabStrip.current?.querySelector<HTMLButtonElement>(
+      '[aria-selected="true"]',
+    );
+    active?.scrollIntoView({ block: "nearest", inline: "nearest" });
+    if (restoreTabFocus.current) {
+      active?.focus();
+      restoreTabFocus.current = false;
+    }
+    // oxlint-disable-next-line react/exhaustive-effect-dependencies -- Selection and closure changes reveal and focus the active tab after React updates the strip.
+  }, [props.activeId, props.tabs.length]);
+  return (
+    <div
+      className="review-tabstrip"
+      ref={tabStrip}
+      role="tablist"
+      aria-label="Open review pages"
+    >
+      {props.tabs.map((tab, index) => (
+        <div
+          className="review-tab"
+          key={tab.id}
+          data-active={tab.id === props.activeId}
+        >
+          <button
+            role="tab"
+            id={`review-tab-${tab.id}`}
+            aria-selected={tab.id === props.activeId}
+            aria-controls="source-diff-panel"
+            tabIndex={tab.id === props.activeId ? 0 : -1}
+            title={tab.label}
+            onClick={() => props.onActivate(tab.id)}
+            onKeyDown={(event) => {
+              if (event.key === "Delete" && tab.id !== 0) {
+                event.preventDefault();
+                restoreTabFocus.current = true;
+                props.onClose(tab.id);
+                return;
+              }
+              if (
+                !["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)
+              )
+                return;
+              event.preventDefault();
+              const target =
+                event.key === "Home"
+                  ? 0
+                  : event.key === "End"
+                    ? props.tabs.length - 1
+                    : (index +
+                        (event.key === "ArrowRight" ? 1 : -1) +
+                        props.tabs.length) %
+                      props.tabs.length;
+              restoreTabFocus.current = true;
+              props.onActivate(props.tabs[target]!.id);
+            }}
+          >
+            {tab.label}
+          </button>
+          {tab.id !== 0 && (
+            <button
+              className="review-tab-close"
+              aria-label={`Close ${tab.label}`}
+              onClick={() => {
+                restoreTabFocus.current = true;
+                props.onClose(tab.id);
+              }}
+            >
+              ×
+            </button>
+          )}
+        </div>
+      ))}
+    </div>
+  );
+}
