+test("Text links open validated explanations with file context", () => {
+  const source =
+    "[Read the validator](explain:validate)\n\n" +
+    document({
+      ...explanation,
+      file: "main.py",
+      changes: "Reject invalid rows before saving.",
+    } as typeof explanation);
+  const result = parseViewerDocument(source);
+  assert.ok(!(result instanceof Error));
+  assert.equal(result.explanations.validate?.file, "main.py");
+  assert.equal(
+    result.explanations.validate?.changes,
+    "Reject invalid rows before saving.",
+  );
+  assert.ok(
+    parseViewerDocument(
+      source.replace("(explain:validate)", "(explain:missing)"),
+    ) instanceof Error,
+  );
+  assert.ok(
+    parseViewerDocument(
+      document({ ...explanation, file: 42 } as typeof explanation),
+    ) instanceof Error,
+  );
+});
+
+test("Detail media validates linked call stacks and preserves code examples", () => {
+  const detail = {
+    ...explanation,
+    callstack:
+      "Request\n└── Validate [[explain:validate]]\n    └── Runner.run [[main.py#Runner.run]]",
+    codeExample: '{"sequence":0,"type":"run.started"}',
+    codeLanguage: "json",
+    codeCaption: "Illustrative record excerpt.",
+    diagramCaption: "Each arrow passes a file.",
+  };
+  const result = parseViewerDocument(document(detail));
+  assert.ok(!(result instanceof Error));
+  assert.equal(
+    result.explanations.validate?.flow[1]?.explanationId,
+    "validate",
+  );
+  assert.equal(
+    result.explanations.validate?.flow[2]?.references[0]?.kind,
+    "file",
+  );
+  assert.equal(result.explanations.validate?.codeExample, detail.codeExample);
+  assert.ok(
+    parseViewerDocument(
+      document({ ...detail, callstack: "Unknown [[explain:missing]]" }),
+    ) instanceof Error,
+  );
+  assert.ok(
+    parseViewerDocument(
+      document({ ...detail, codeExample: 42 } as unknown as typeof explanation),
+    ) instanceof Error,
+  );
+});
