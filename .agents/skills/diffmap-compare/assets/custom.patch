+function describeSymbol(
+  service: ts.LanguageService,
+  source: ts.SourceFile,
+  position: number,
+  workspaceRoot: string,
+): SymbolInfo | undefined {
+  const checker = service.getProgram()!.getTypeChecker();
+  const quick = service.getQuickInfoAtPosition(source.fileName, position);
+  if (quick === undefined) return undefined;
+  let token: ts.Node = source;
+  const visit = (node: ts.Node) => {
+    if (node.getStart(source) <= position && position < node.end) {
+      token = node;
+      ts.forEachChild(node, visit);
+    }
+  };
+  visit(source);
+  let symbol = checker.getSymbolAtLocation(token);
+  if (symbol === undefined) return undefined;
+  if (symbol.flags & ts.SymbolFlags.Alias)
+    symbol = checker.getAliasedSymbol(symbol);
+  const declaration =
+    symbol.valueDeclaration === undefined
+      ? symbol.declarations?.[0]
+      : symbol.valueDeclaration;
+  if (declaration === undefined) return undefined;
+  const type = checker.getTypeOfSymbolAtLocation(symbol, declaration);
+  const isClass = ts.isClassDeclaration(declaration);
+  const constructor = isClass
+    ? declaration.members.find(ts.isConstructorDeclaration)
+    : undefined;
+  const signature =
+    constructor === undefined
+      ? type.getCallSignatures()[0]
+      : checker.getSignatureFromDeclaration(constructor);
+  const parent = declaration.parent;
+  const owner =
+    ts.isClassDeclaration(parent) || ts.isInterfaceDeclaration(parent)
+      ? parent.name?.text
+      : undefined;
+  const name = owner === undefined ? symbol.name : `${owner}.${symbol.name}`;
+  const flags =
+    ts.TypeFormatFlags.NoTruncation |
+    ts.TypeFormatFlags.MultilineObjectLiterals;
+  const format = (value: ts.Type) =>
+    checker.typeToString(value, declaration, flags);
+  const parameters =
+    signature === undefined
+      ? []
+      : signature.getParameters().map((parameter) => ({
+          name: parameter.name,
+          type: format(
+            checker.getTypeOfSymbolAtLocation(parameter, declaration),
+          ),
+        }));
+  const structural =
+    isClass ||
+    ts.isInterfaceDeclaration(declaration) ||
+    ts.isTypeAliasDeclaration(declaration);
+  const declared = structural
+    ? checker.getDeclaredTypeOfSymbol(symbol)
+    : undefined;
+  const sourceLocation = (node: ts.Declaration): SymbolLocation | undefined => {
+    const named = node as ts.NamedDeclaration;
+    if (named.name === undefined) return undefined;
+    const targetFile = node.getSourceFile();
+    const relative = path.relative(workspaceRoot, targetFile.fileName);
+    if (relative.startsWith("..") || path.isAbsolute(relative))
+      return undefined;
+    const start = targetFile.getLineAndCharacterOfPosition(
+      named.name.getStart(targetFile),
+    );
+    return {
+      path: relative,
+      line: start.line + 1,
+      column: start.character,
+      text: targetFile.text.split(/\r?\n/)[start.line]!,
+    };
+  };
+  const signatureText = ts.displayPartsToString(quick.displayParts);
+  const returnType = isClass
+    ? symbol.name
+    : signature === undefined
+      ? undefined
+      : format(signature.getReturnType());
+  const members =
+    declared === undefined
+      ? []
+      : declared.getProperties().map((member) => {
+          const node =
+            member.valueDeclaration === undefined
+              ? member.declarations?.[0]
+              : member.valueDeclaration;
+          return {
+            name: member.name,
+            type: format(
+              checker.getTypeOfSymbolAtLocation(member, declaration),
+            ),
+            location: node === undefined ? undefined : sourceLocation(node),
+          };
+        });
+  const typeText = [
+    signatureText,
+    ...parameters.map((parameter) => parameter.type),
+    returnType === undefined ? "" : returnType,
+    ...members.map((member) => member.type),
+  ].join(" ");
+  const typeNames = new Set(typeText.match(/[A-Za-z_$][\w$]*/g));
+  const typeLinks: SymbolInfo["typeLinks"] = [];
+  for (const typeName of typeNames) {
+    let resolved = checker.resolveName(
+      typeName,
+      declaration,
+      ts.SymbolFlags.Type | ts.SymbolFlags.Alias,
+      false,
+    );
+    if (resolved === undefined) continue;
+    if (resolved.flags & ts.SymbolFlags.Alias)
+      resolved = checker.getAliasedSymbol(resolved);
+    const node = resolved.declarations?.[0];
+    if (node === undefined) continue;
+    const location = sourceLocation(node);
+    if (location !== undefined) typeLinks.push({ name: typeName, location });
+  }
+  return {
+    name,
+    kind: quick.kind,
+    signature: signatureText,
+    documentation: ts.displayPartsToString(quick.documentation),
+    parameters,
+    returnType,
+    members,
+    typeLinks,
+  };
+}
