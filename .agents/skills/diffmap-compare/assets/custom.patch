+function makeTab(selection: SourceSelection, id: number): PanelTab {
+  const explanationId = selection.annotation.explanationId;
+  const explanation =
+    explanationId === undefined
+      ? undefined
+      : viewerDocument.explanations[explanationId];
+  const definition = selection.definition;
+  const reference = selection.reference;
+  const path =
+    reference?.kind === "file"
+      ? reference.path
+      : viewerDocument.sourceDiffs.find((item) => item.id === reference?.id)
+          ?.fileDiff.name;
+  const key =
+    definition !== undefined
+      ? `symbol:${definition.path}:${definition.start}:${definition.symbol?.kind}`
+      : explanationId !== undefined
+        ? `explanation:${explanationId}`
+        : `source:${path ?? JSON.stringify(reference)}`;
+  const title =
+    explanation === undefined ? selection.annotation.text : explanation.title;
+  const label =
+    definition?.symbol !== undefined
+      ? definition.symbol.name
+      : explanation?.file !== undefined
+        ? explanation.file.split("/").at(-1)!
+        : (path?.split("/").at(-1) ?? title);
+  return { id, key, label, selection };
+}
