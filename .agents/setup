#!/usr/bin/env bash
set -euo pipefail

# Bash's time keyword also reports failed steps before set -e exits.
TIMEFORMAT='==> Step took %3R seconds'

if ! command -v Xvfb >/dev/null || ! command -v pdftotext >/dev/null; then
  echo "==> Installing system dependencies"
  sudo apt-get update -qq
  sudo apt-get install -y -qq poppler-utils xvfb
fi

NODE_VERSION="$(cat .node-version)"
NODE_HOME="$HOME/.local/node-v${NODE_VERSION}"
if [[ ! -x "$NODE_HOME/bin/node" ]]; then
  echo "==> Installing Node ${NODE_VERSION}"
  archive="$(mktemp)"
  trap 'rm -f "$archive"' EXIT
  curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o "$archive"
  mkdir -p "$NODE_HOME"
  tar -xJf "$archive" -C "$NODE_HOME" --strip-components=1
fi
mkdir -p "$HOME/.local/bin"
for executable in node npm npx corepack; do
  ln -sfn "$NODE_HOME/bin/$executable" "$HOME/.local/bin/$executable"
done
export PATH="$HOME/.local/bin:$PATH"
hash -r
node --version

# Preserve Bash's login-file precedence instead of shadowing an existing file.
login_profile="$HOME/.profile"
for candidate in "$HOME/.bash_profile" "$HOME/.bash_login"; do
  if [[ -r "$candidate" ]]; then
    login_profile="$candidate"
    break
  fi
done
# Non-interactive login shells do not read the .bashrc that pnpm setup updates.
for setting in \
  'export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"' \
  'export PATH="$PNPM_HOME/bin:$PNPM_HOME:$HOME/.local/bin:$PATH"'; do
  if ! grep -Fqx "$setting" "$login_profile" 2>/dev/null; then
    echo "$setting" >> "$login_profile"
  fi
done

# Corepack wraps pnpm in a Node shim and does not install pnpm 12's native binary.
PNPM_VERSION="$(node -p "require('./package.json').packageManager.slice('pnpm@'.length)")"
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
export PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"

# Check outside the workspace so pnpm cannot auto-switch to packageManager's version.
installed="$(cd "$HOME" && pnpm --version 2>/dev/null || true)"
if [[ "$installed" != "$PNPM_VERSION" ]]; then
  echo "==> Installing pnpm ${PNPM_VERSION} (${SECONDS}s elapsed)"
  time curl -fsSL https://get.pnpm.io/install.sh | env PNPM_VERSION="$PNPM_VERSION" PNPM_HOME="$PNPM_HOME" sh -
fi
hash -r
pnpm --version

echo "==> Installing workspace dependencies (${SECONDS}s elapsed)"
time pnpm install --frozen-lockfile

echo "==> Checking Playwright system dependencies (${SECONDS}s elapsed)"
# Playwright 1.62's dry run exits nonzero if apt would install packages.
# Avoid apt-get update on warm snapshots without duplicating its package list.
if ! pnpm exec playwright install-deps --dry-run chromium; then
  time pnpm exec playwright install-deps chromium
fi

echo "==> Installing Playwright Chromium (${SECONDS}s elapsed)"
time pnpm exec playwright install chromium
echo "==> Setup completed in ${SECONDS}s"
