+func TestExtractModifiedFiles_ApplyPatch(t *testing.T) {
+	transcript := `{"threadID":"T-patch","role":"assistant","messageId":"a1","content":[{"type":"tool_use","id":"patch1","name":"apply_patch","input":{"patchText":"*** Begin Patch\r\n*** Add File: /work/added.txt\r\n+*** Delete File: not-a-file.txt\r\n*** Update File: /work/updated.txt\r\n@@\r\n-old\r\n+new\r\n*** Delete File: /work/deleted.txt\r\n*** Update File: /work/old.txt\r\n*** Move to: /work/new name.txt\r\n@@\r\n-old\r\n+new\r\n*** End Patch"}},{"type":"tool_use","id":"read1","name":"read_file","input":{"path":"ignored.txt","patchText":"*** Delete File: also-ignored.txt"}}]}
+{"threadID":"T-patch","role":"user","messageId":"u1","content":[{"type":"tool_result","toolUseID":"patch1","run":{"status":"done","result":{"files":[{"uri":"file:///work/updated.txt"},{"uri":"file:///work/new%20name.txt"}]}}},{"type":"tool_result","toolUseID":"read1","run":{"status":"done","result":{"files":[{"uri":"file:///work/ignored.txt"}]}}}]}
+`
+	path := filepath.Join(t.TempDir(), "amp.jsonl")
+	if err := os.WriteFile(path, []byte(transcript), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name   string
+		offset int
+		want   []string
+	}{
+		{"all operations", 0, []string{"/work/added.txt", "/work/deleted.txt", "/work/new name.txt", "/work/old.txt", "/work/updated.txt"}},
+		{"result after offset", 1, []string{"/work/new name.txt", "/work/updated.txt"}},
+		{"past end", 2, []string{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			files, pos, err := New().ExtractModifiedFiles(path, tc.offset)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if pos != 2 || len(files) != len(tc.want) {
+				t.Fatalf("files = %v position = %d, want %v at position 2", files, pos, tc.want)
+			}
+			for i := range tc.want {
+				if files[i] != tc.want[i] {
+					t.Fatalf("files = %v, want %v", files, tc.want)
+				}
+			}
+		})
+	}
+}
