+func TestAgentAdd_LocalPreservesProjectSettings(t *testing.T) {
+	// Cannot use t.Parallel: setupTestRepo changes cwd and environment.
+	setupTestRepo(t)
+	writeSettings(t, testSettingsEnabled)
+	before, err := os.ReadFile(EntireSettingsFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd := newAgentAddCmd()
+	cmd.SetArgs([]string{"claude-code", "--local"})
+	cmd.SetOut(&bytes.Buffer{})
+	cmd.SetErr(&bytes.Buffer{})
+	if err := cmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+	after, err := os.ReadFile(EntireSettingsFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(before, after) {
+		t.Fatal("agent add --local changed project settings")
+	}
+	if !settings.IsSetUpLocal(context.Background()) {
+		t.Fatal("agent add --local did not write local settings")
+	}
+}
