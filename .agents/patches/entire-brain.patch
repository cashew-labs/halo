+// Off-checkout uploads must not rebuild that branch's store using HEAD visibility.
+func TestMemoriesSyncPushOnlyPreservesOtherBranch(t *testing.T) {
+	now := time.Date(2026, 6, 9, 12, 0, 0, 0, time.UTC)
+	for _, denied := range []bool{false, true} {
+		t.Run(map[bool]string{false: "uploaded", true: "denied"}[denied], func(t *testing.T) {
+			fake := &hostedFake{denyFeed: true, denyPush: denied}
+			f, baseURL := newHostedSyncCmdFixture(t, fake)
+			fact := hostedSyncTestFact("saved on another branch", now)
+			f.writeFacts(t, "unmerged", []factRecord{fact})
+			out, err := execute(t, NewRootCommand(f.opts), "memories", "sync", "--branch", "unmerged", "--push-only", "--memories-backend", "http", "--repo-id", "repo1", "--api-url", baseURL, "--json")
+			if denied {
+				if err == nil {
+					t.Fatal("denied upload must fail")
+				}
+			} else {
+				if err != nil || !fake.has(fact.ID) {
+					t.Fatalf("upload failed: %v\n%s", err, out)
+				}
+				var result struct {
+					PushOnly bool `json:"push_only"`
+				}
+				if json.Unmarshal([]byte(out), &result) != nil || !result.PushOnly {
+					t.Fatalf("missing upload-only receipt: %s", out)
+				}
+			}
+			local, loadErr := factstore.Load(f.brainDir, "unmerged")
+			if loadErr != nil || len(local) != 1 || local[0].ID != fact.ID {
+				t.Fatalf("off-checkout store changed: %v", loadErr)
+			}
+		})
+	}
+}
