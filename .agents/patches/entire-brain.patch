+func TestMemoriesSyncPreservesSelectedBranchWhenCheckoutDiffers(t *testing.T) {
+	const tip = "abc123abc123abc123abc123abc123abc123abcd"
+	const anchor = "def123def123def123def123def123def123abcd"
+	for _, missing := range []bool{false, true} {
+		t.Run(map[bool]string{false: "other checkout", true: "missing branch"}[missing], func(t *testing.T) {
+			fact := hostedSyncAnchoredFact("teammate decision on main", time.Date(2026, 6, 9, 12, 0, 0, 0, time.UTC), factmerge.Anchor{Commit: anchor})
+			fake := &hostedFake{}
+			fake.seed(fact, "", "acct-teammate", "teammate")
+			f, _ := newHostedSyncCmdFixture(t, fake)
+			f.runner.responses[fakeCommandKey("git", "branch", "--show-current")] = fakeCommandResponse{stdout: "other\n"}
+			f.runner.responses[fakeCommandKey("git", "merge-base", "--is-ancestor", anchor, tip)] = fakeCommandResponse{}
+			if missing {
+				delete(f.runner.responses, fakeCommandKey("git", "rev-parse", "--verify", "refs/heads/main^{commit}"))
+			}
+			f.writeFacts(t, "main", []factRecord{fact})
+			out, err := execute(t, NewRootCommand(f.opts), "memories", "sync", "--branch", "main")
+			if (err != nil) != missing {
+				t.Fatalf("missing=%v, error=%v\n%s", missing, err, out)
+			}
+			local, loadErr := factstore.Load(f.brainDir, "main")
+			if loadErr != nil || len(local) != 1 || local[0].ID != fact.ID {
+				t.Fatalf("selected branch lost its teammate memory: %v", loadErr)
+			}
+		})
+	}
