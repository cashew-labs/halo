{
  "name": "@get-halo/root",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "HALO_WORKSPACE_ROOT=$INIT_CWD/tmp/workspace HALO_USER_DATA=$INIT_CWD/tmp/workspace/.halo turbo run dev --filter=@get-halo/desktop --filter=@get-halo/control-plane --filter=@get-halo/workspace-server --env-mode=loose",
    "halo": "pnpm --silent --filter @get-halo/cli cli",
    "tkstack": "pnpm --silent exec tkstack",
    "spec": "pnpm --silent exec tkstack",
    "walkthrough": "pnpm --silent exec tkstack",
    "infra:bootstrap": "bash infra/bootstrap.sh",
    "infra:control-plane:preview": "pnpm --filter @get-halo/infra control-plane:preview",
    "infra:control-plane:up": "pnpm --filter @get-halo/infra control-plane:up",
    "infra:workspace:preview": "pnpm --filter @get-halo/infra workspace:preview",
    "infra:workspace:up": "pnpm --filter @get-halo/infra workspace:up",
    "prerelease": "node releases/createRelease.mjs",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck lint format:check test --affected --concurrency=1",
    "check:static": "turbo run typecheck lint format:check --affected --concurrency=1",
    "check-affected": "pnpm run check",
    "server": "pnpm --filter @get-halo/workspace-server start"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tkstack": "^0.1.3",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.1.0"
}
