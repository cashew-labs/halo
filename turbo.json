{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tools/oxlint/anti-slop/**",
        "$TURBO_ROOT$/tools/oxlint/no-unused-exports/**"
      ]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tools/oxlint/anti-slop/**",
        "$TURBO_ROOT$/tools/oxlint/no-unused-exports/**"
      ]
    },
    "format": {
      "dependsOn": ["^format"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    "format:check": {
      "dependsOn": ["^format:check"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:unit": {},
    "test:e2e": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
