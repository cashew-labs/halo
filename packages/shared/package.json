{
  "name": "@get-halo/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./controlPlaneContract": "./src/controlPlaneContract.ts",
    "./isCallable": "./src/isCallable.ts",
    "./SerialQueue": "./src/SerialQueue.ts",
