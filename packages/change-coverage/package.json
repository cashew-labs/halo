{
  "name": "@get-halo/change-coverage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src test",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src test",
    "test:unit": "vitest run test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "errore": "^0.14.1",
    "execa": "9.6.1"
  },
  "devDependencies": {
    "@get-halo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
