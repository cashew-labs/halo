{
  "name": "halo-copy-path-to-symbol",
  "displayName": "Copy Path to Selection",
  "version": "0.1.2",
  "private": true,
  "description": "Copy a workspace-relative file path with the selected line numbers.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "publisher": "halo",
  "main": "./extension.js",
  "scripts": {
    "test": "pnpm run test:unit",
    "test:unit": "node --test rangePath.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "halo.copyPathToSelection",
        "title": "Copy Path to Selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "halo.copyPathToSelection",
          "group": "navigation@20",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "activationEvents": [
    "onCommand:halo.copyPathToSelection"
  ],
  "engines": {
    "vscode": "^1.85.0"
  }
}
