{
  "name": "@get-halo/dev-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings src",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@get-halo/app-control": "workspace:*",
    "errore": "^0.14.1",
    "incur": "^0.4.20",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@get-halo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
