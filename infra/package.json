{
  "name": "@get-halo/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "control-plane:preview": "pulumi -C control-plane preview",
    "control-plane:up": "pulumi -C control-plane up",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --deny-warnings .",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix .",
    "workspace:preview": "pulumi -C workspace preview",
    "workspace:up": "pulumi -C workspace up",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pulumi/gcp": "^9.36.1",
    "@pulumi/pulumi": "^3.262.0",
    "@pulumi/random": "^4.21.1",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@get-halo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "7.0.2"
  }
}
