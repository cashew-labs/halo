{
  "extends": "@get-halo/typescript-config/base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".",
    "target": "ESNext",
    "types": ["node"]
  },
  "include": ["control-plane/**/*.ts", "workspace/**/*.ts"],
  "exclude": ["node_modules"]
}
